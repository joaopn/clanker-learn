# clanker-learn's settings for this machine. ./setup copies this file to .env (and sets
# CL_MODE); edit .env, then `docker compose up -d` to apply. The defaults are in compose.yaml.

# How the container runs its own Docker daemon: sysbox | privileged.
# sysbox needs sysbox installed on the machine (./setup checks Docker for it). Without it,
# use privileged: the container is then root-equivalent on the machine (INSTALL.md says more).
CL_MODE=sysbox

# The address every port is published on. The default is this machine's loopback address
# only, so the page can be reached from this machine and no other. To reach it from another
# machine, bind one specific address of this one (its LAN or tailnet address).
# CL_BIND=127.0.0.1

# Each port below is published on the same number outside the container as inside: the page
# builds the tabs' addresses from these numbers. Ports are 1024 to 65535 and none may overlap.

# The page (HTTPS).
# CL_WEB_PORT=7788

# The web-app tabs, one port per tab (65 tabs at once by default).
# CL_ORIGIN_PORTS=11100-11164

# The raw TCP ports you name by hand in a project. No login is in front of them.
# CL_PASSTHROUGH_PORTS=11200-11299

# The status answer (http://127.0.0.1:8080/state.json): how the start is going.
# CL_STATUS_PORT=8080

# on | off. Off, there is no page: no web server, no tutor service, no set-up code. Projects
# and the `cl` command work all the same.
# CL_WEB=on

# The two named volumes. The data volume holds everything that is yours (projects,
# conversations, the password, settings, backups); the other the inner Docker's images and
# the sandboxes' containers.
# CL_DATA_VOLUME=clanker-learn-data
# CL_DOCKER_VOLUME=clanker-learn-docker
