# The versions of the software clanker-learn puts into its projects: Claude Code, pi and the
# editor (code-server). Each is fetched once, at this version, by a throwaway container, into
# a distribution on the data volume, which projects get their copy from.
#
# This file is the repository's baseline and is part of the image (/opt/cl/versions.env).
# /data/versions.local.env overrides it key by key: Refresh (Settings -> Software, or
# `cl agent refresh` / `cl editor refresh`) raises a version there, never here and never
# down, and "Use repo version" takes that key out again.
#
# One KEY=VALUE a line; a version is digits and dots only. CLAUDE_CODE_EXT_VERSION is Claude
# Code's editor extension (Open VSX), bundled into its distribution and refreshed with it.
# The last six are the extensions bundled into the editor's distribution (Open VSX, universal
# packages), research-sandbox's pins; Refresh does not move them: raise one here or in the
# override by hand, then Pull the editor.
CLAUDE_CODE_VERSION=2.1.330
CODE_SERVER_VERSION=4.126.0
CLAUDE_CODE_EXT_VERSION=2.1.330
PYTHON_EXT_VERSION=2026.4.0
JUPYTER_VERSION=2025.9.1
JUPYTER_CELL_TAGS_VERSION=0.1.9
JUPYTER_KEYMAP_VERSION=1.1.2
JUPYTER_RENDERERS_VERSION=1.3.0
JUPYTER_SLIDESHOW_VERSION=0.1.6

# pi (the pi coding agent, an npm package), research-sandbox's pins (its versions.env), with
# research-sandbox's meaning. Its distribution carries a PRIVATE node runtime (nodejs.org's
# tarball at NODE_VERSION), the package installed with npm at PI_CODING_AGENT_VERSION,
# pi-subagents (npm) at PI_SUBAGENTS_VERSION, RS's rules extension (outer/pi/rs-rules.ts, whose
# first line must carry RS_PI_RULES_VERSION) and RS's launcher, so one tree runs from any home.
# RS_PI_DIST_LAYOUT is no upstream version but a counter of the tree's layout. Each of the five
# is recorded in the distribution: one that moved reads "stale — re-pull" until pi is pulled
# again. Refresh moves PI_CODING_AGENT_VERSION only (as RS's does); the others are raised by
# hand, here or in the override.
PI_CODING_AGENT_VERSION=1.5.0
NODE_VERSION=24.18.0
PI_SUBAGENTS_VERSION=0.84.0
RS_PI_RULES_VERSION=0.8.0
RS_PI_DIST_LAYOUT=2
